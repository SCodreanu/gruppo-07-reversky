# File necessari per utilizzare e avviare il progetto con docker compose

POSTGRES_DB=reversky
POSTGRES_USER=reversky
POSTGRES_PASSWORD=reversky
POSTGRES_PORT=5432
API_PORT=8080
MAILPIT_UI_PORT=8025
WEB_PORT=3000

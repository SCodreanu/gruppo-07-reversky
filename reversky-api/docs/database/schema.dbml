////////////////////////////////////////////////////////////
// REVERSKY — SCHEMA DEL DATABASE (PostgreSQL 18)
//
// Fonte di verità per le migrazioni Flyway. Le regole che il
// database non può garantire sono nei documenti di ogni funzionalità.
////////////////////////////////////////////////////////////


////////////////////////////////////////////////////////////
// ENUM
////////////////////////////////////////////////////////////

Enum CardType {
  CREATURE
  TERRAIN
  SPELL
  HIDDEN
  ITEM [note: 'Oggetto: come il Terreno viene messo accanto al mazzo; effetto monouso, poi si consuma (D-47).']
}

Enum CardSubtype {
  DAMAGE
  SHIELD
  BURN
  SURVIVAL
}

Enum BattleInviteStatus {
  PENDING
  ACCEPTED
}

Enum BattleResult {
  CHALLENGER_WIN
  OPPONENT_WIN
  DRAW
}

Enum BattleMode {
  FRIENDLY [note: 'Invito tra amici. Non cambia il rating.']
  RANKED [note: 'Creata dal matchmaking. Aggiorna il rating Elo.']
}

Enum FriendshipStatus {
  PENDING
  ACCEPTED
}

Enum TradeStatus {
  REJECTED
  ACCEPTED
  WAITING_REQUESTER
  WAITING_RECIPIENT
}

Enum CreditReason {
  SIGNUP
  BATTLE_WIN
  BATTLE_DRAW
  PACK_PURCHASE
  ADMIN_ADJUSTMENT
}


////////////////////////////////////////////////////////////
// UTENTI E AUTENTICAZIONE
////////////////////////////////////////////////////////////

Table roles {
  id int [pk, increment]
  name varchar(100) [not null, unique]
}

Table users {
  id int [pk, increment]
  role_id int [not null, ref: > roles.id]

  username varchar(30) [not null, unique]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]

  is_enabled boolean [not null, default: true]

  email_verified_at timestamptz                                  // nullo = email non ancora verificata
  privacy_accepted_at timestamptz [not null]
  terms_accepted_at timestamptz [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    role_id
  }
}

Table refresh_tokens {
  id uuid [pk]
  user_id int [not null, ref: > users.id]

  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id
    expires_at
  }

  Note: 'Si salva solo l hash del token, mai il valore in chiaro.'
}

Table password_reset_tokens {
  id uuid [pk]
  user_id int [not null, ref: > users.id]

  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id
    expires_at
  }

  Note: 'Un solo token attivo per utente, garantito dal codice. I token si eliminano dopo un reset riuscito.'
}

Table email_verification_tokens {
  id uuid [pk]
  user_id int [not null, ref: > users.id]

  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id
    expires_at
  }

  Note: 'Il token si elimina dopo una verifica riuscita, che valorizza users.email_verified_at.'
}


////////////////////////////////////////////////////////////
// CATALOGO DELLE CARTE
////////////////////////////////////////////////////////////

Table rarities {
  id int [pk, increment]
  name varchar(100) [not null, unique]

  // Copie massime di una singola carta di questa rarità in un mazzo,
  // prima di considerare il limite specifico della carta.
  deck_limit int [not null]

  // Bilanciamento: carte massime di questa rarità in un mazzo (nullo = nessun limite).
  max_per_deck int

  // Nessun massimo di ATK e DEF per rarità: le carte personalizzate possono superare qualsiasi soglia.

  sorting_order int [not null, unique]

  Checks {
    `deck_limit >= 1` [name: 'chk_rarities_deck_limit']
    `max_per_deck IS NULL OR max_per_deck >= 0` [name: 'chk_rarities_max_per_deck']
  }

  Note: 'Il limite reale di copie nel mazzo è il minimo tra deck_limit e catalog_cards.copy_limit.'
}

// Valori di gioco modificabili dal backoffice: regole inviate all'engine,
// composizione del mazzo e crediti. Niente di questo sta nel codice dell'API o dell'engine.
Table rule_sets {
  id int [pk, increment]

  version varchar(20) [not null, unique]        // es. "1.0", inviato all'engine come rulesVersion
  is_active boolean [not null, default: false]  // esattamente un rule set attivo

  // Partita (inviati all'engine a ogni simulazione)
  starting_life_points int [not null]
  max_rounds int [not null]                // round totali della partita

  // Composizione del mazzo
  deck_size int [not null]
  deck_creatures int [not null]
  deck_spells int [not null]
  deck_hidden int [not null]
  deck_items int [not null]                // Oggetti
  deck_terrains int [not null]
  max_hidden_survival int [not null]
  max_hidden_damage int [not null]

  // Crediti: vittoria e pareggio solo per le partite RANKED, le FRIENDLY non danno crediti
  signup_bonus int [not null]
  win_reward int [not null]
  draw_reward int [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  created_by_id int [ref: > users.id]

  Indexes {
    is_active [unique, name: 'uq_rule_sets_one_active', note: 'indice parziale: WHERE is_active']
  }

  Checks {
    `starting_life_points >= 1 AND max_rounds >= 1` [name: 'chk_rule_sets_match']
    `deck_creatures >= 1 AND deck_spells >= 0 AND deck_hidden >= 0 AND deck_items >= 0 AND deck_terrains >= 0` [name: 'chk_rule_sets_deck_parts']
    `deck_creatures + deck_spells + deck_hidden + deck_items + deck_terrains = deck_size` [name: 'chk_rule_sets_deck_size']
    `max_hidden_survival >= 0 AND max_hidden_damage >= 0` [name: 'chk_rule_sets_hidden']
    `signup_bonus >= 0 AND win_reward >= 0 AND draw_reward >= 0` [name: 'chk_rule_sets_credits']
  }

  Note: 'Valori di gioco versionati, gestiti dal backoffice. Una sola riga è attiva. Un rule set già usato da una partita non si modifica: si crea una nuova versione e la si attiva.'
}

Table factions {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  emblem_path text [not null]
  description text
}

Table faction_bonuses {
  origin_faction_id int [not null, ref: > factions.id]
  target_faction_id int [not null, ref: > factions.id]

  atk_bonus int [not null, default: 0]   // può essere negativo: -1 è il malus contro la fazione che ti batte
  def_bonus int [not null, default: 0]

  Indexes {
    (origin_faction_id, target_faction_id) [pk]
    target_faction_id
  }

  Checks {
    `origin_faction_id != target_faction_id` [name: 'chk_faction_bonuses_no_self_matchup']
    `def_bonus >= 0` [name: 'chk_faction_bonuses_def_nonnegative']
  }

  Note: 'Bonus di una fazione di origine contro una fazione bersaglio. atk_bonus può essere negativo (malus), def_bonus no. Una fazione non ha bonus contro se stessa.'
}

Table catalog_cards {
  id int [pk, increment]

  rarity_id int [not null, ref: > rarities.id]
  faction_id int [ref: > factions.id]             // obbligatoria per Creature, Terreni e Oggetti; nulla per Spell e Hidden, che sono condivise tra le fazioni
  secondary_faction_id int [ref: > factions.id]   // seconda fazione facoltativa (es. Mutant): la carta prende bonus e malus di entrambe
  variant_of_id int [ref: > catalog_cards.id]     // versione evento di un'altra carta: stesse regole, altra grafica. Nullo = carta originale

  name varchar(255) [not null]
  type CardType [not null]
  subtype CardSubtype              // solo Spell e Hidden
  effect_code varchar(100)         // codice di un effetto implementato nell'engine, inviato come effectCode

  image_path text [not null]

  effect_description text   // testo dell'effetto mostrato ai giocatori
  flavor_text text          // testo di sapore della lore

  // Solo le creature hanno statistiche.
  atk int
  def int

  // Limite specifico della carta. Nullo = vale solo il limite della rarità.
  // Il limite reale nel mazzo è il minimo tra i due.
  copy_limit int

  is_active boolean [not null, default: true]

  Indexes {
    rarity_id
    faction_id
    secondary_faction_id
    variant_of_id
    (rarity_id, faction_id)
    (is_active, rarity_id)
    name [unique, name: 'uq_catalog_cards_base_name', note: 'indice parziale: WHERE variant_of_id IS NULL']
  }

  Checks {
    `copy_limit IS NULL OR copy_limit >= 1` [name: 'chk_catalog_cards_copy_limit']
    `(type = 'CREATURE' AND atk IS NOT NULL AND def IS NOT NULL AND atk >= 0 AND def >= 1) OR (type <> 'CREATURE' AND atk IS NULL AND def IS NULL)` [name: 'chk_catalog_cards_stats_match_type']
    `(type IN ('SPELL', 'HIDDEN') AND faction_id IS NULL AND secondary_faction_id IS NULL) OR (type NOT IN ('SPELL', 'HIDDEN') AND faction_id IS NOT NULL)` [name: 'chk_catalog_cards_faction_matches_type']
    `secondary_faction_id IS NULL OR (faction_id IS NOT NULL AND secondary_faction_id != faction_id)` [name: 'chk_catalog_cards_distinct_factions']
    `(type = 'SPELL' AND subtype IS NOT NULL AND subtype IN ('DAMAGE', 'SHIELD', 'BURN')) OR (type = 'HIDDEN' AND subtype IS NOT NULL AND subtype IN ('SURVIVAL', 'DAMAGE')) OR (type IN ('CREATURE', 'TERRAIN', 'ITEM') AND subtype IS NULL)` [name: 'chk_catalog_cards_subtype_matches_type']
    `type = 'CREATURE' OR effect_code IS NOT NULL` [name: 'chk_catalog_cards_effect_required']
    `variant_of_id IS NULL OR variant_of_id != id` [name: 'chk_catalog_cards_not_own_variant']
  }

  Note: 'I tag si assegnano tramite card_tags e servono ai filtri dei pacchetti. Effetto e sottotipo stanno nelle colonne effect_code e subtype.'
}

Table collection_cards {
  user_id int [not null, ref: > users.id]
  card_id int [not null, ref: > catalog_cards.id]

  quantity int [not null]

  Indexes {
    (user_id, card_id) [pk]
    card_id
  }

  Checks {
    `quantity > 0` [name: 'chk_collection_cards_quantity_positive']
  }

  Note: 'La riga si elimina quando l utente non ha più copie della carta.'
}


////////////////////////////////////////////////////////////
// TAG
////////////////////////////////////////////////////////////

Table tags {
  id int [pk, increment]
  name varchar(100) [not null, unique]

  Checks {
    `name ~ '^[A-Z0-9_]+$'` [name: 'chk_tags_name_format']
  }

  Note: 'Etichette libere per i filtri dei pacchetti. Esempi: WOUND, INVITATION, ARCHIVE, DREAM, YOKAI.'
}

Table card_tags {
  card_id int [not null, ref: > catalog_cards.id]
  tag_id int [not null, ref: > tags.id]

  Indexes {
    (card_id, tag_id) [pk]
    tag_id
  }
}

Table faction_tags {
  faction_id int [not null, ref: > factions.id]
  tag_id int [not null, ref: > tags.id]

  Indexes {
    (faction_id, tag_id) [pk]
    tag_id
  }

  Note: 'I tag della fazione contano tra quelli di una carta quando si controlla se può uscire da un pacchetto.'
}


////////////////////////////////////////////////////////////
// MAZZI
////////////////////////////////////////////////////////////

Table decks {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]

  name varchar(50) [not null]

  Indexes {
    (user_id, name) [unique]
  }

  Note: 'Composizione, possesso delle carte e limiti di copie sono controllati dal codice.'
}

Table deck_cards {
  deck_id int [not null] // ON DELETE CASCADE, vedi Ref sotto
  card_id int [not null, ref: > catalog_cards.id]

  quantity int [not null]

  Indexes {
    (deck_id, card_id) [pk]
    card_id
  }

  Checks {
    `quantity > 0` [name: 'chk_deck_cards_quantity_positive']
  }
}

Ref: deck_cards.deck_id > decks.id [delete: cascade]


////////////////////////////////////////////////////////////
// INVITI E PARTITE
////////////////////////////////////////////////////////////

Table battle_invites {
  id uuid [pk]

  challenger_id int [not null, ref: > users.id]
  // Obbligatorio finché l'invito è PENDING; diventa nullo quando il mazzo viene eliminato (vedi Ref sotto).
  challenger_deck_id int
  opponent_id int [not null, ref: > users.id]

  status BattleInviteStatus [not null, default: 'PENDING']

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    challenger_id
    challenger_deck_id
    (opponent_id, status)
    (challenger_id, opponent_id) [unique, name: 'uq_battle_invites_pending_pair', note: 'indice parziale: WHERE status = PENDING']
  }

  Checks {
    `challenger_id != opponent_id` [name: 'chk_battle_invites_no_self_challenge']
    `status <> 'PENDING' OR challenger_deck_id IS NOT NULL` [name: 'chk_battle_invites_pending_has_deck']
  }

  Note: 'Solo partite FRIENDLY. Lo sfidante sceglie il proprio mazzo e un avversario che deve essere un amico (controllato dal codice); l avversario sceglie il mazzo quando accetta. Non cambia mai il rating. Gli inviti non scadono: un invito PENDING si chiude accettandolo, oppure eliminando la riga con un rifiuto o un ritiro. Al massimo un invito PENDING per direzione. Un mazzo usato da un invito PENDING non si può eliminare (409); per gli inviti accettati il riferimento diventa nullo e la partita conserva la propria fotografia del mazzo.'
}

// Gli inviti già accettati non devono bloccare l'eliminazione del mazzo.
Ref: battle_invites.challenger_deck_id > decks.id [delete: set null]

Table battles {
  id uuid [pk]

  mode BattleMode [not null]

  // Valorizzato per le FRIENDLY, nullo per le RANKED (nessun invito).
  invite_id uuid [unique, ref: - battle_invites.id]

  challenger_id int [not null, ref: > users.id]
  opponent_id int [not null, ref: > users.id]

  result BattleResult

  // Rule set attivo quando la partita è stata preparata. Le regole e i bonus di fazione inviati
  // all'engine sono copiati anche in battle_stats, così un retry rigioca esattamente la stessa partita.
  rule_set_id int [not null, ref: > rule_sets.id]

  // Fotografia dell'Elo, solo RANKED. Scritta nella stessa transazione di result.
  challenger_rating_before int
  challenger_rating_delta int
  opponent_rating_before int
  opponent_rating_delta int

  // Fotografie dei mazzi usati nella partita.
  challenger_deck jsonb [not null]
  opponent_deck jsonb [not null]

  // Statistiche della partita (seed, motivo di fine, punti vita finali...).
  battle_stats jsonb [not null]

  // Eventi e risultati dei round.
  rounds_log jsonb [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (challenger_id, created_at)                                 // storico e anti-boosting
    (opponent_id, created_at)                                   // storico e anti-boosting
    rule_set_id                                                 // una versione del rule set è già stata usata?
  }

  Checks {
    `challenger_id != opponent_id` [name: 'chk_battles_no_self_battle']
    `(mode = 'FRIENDLY' AND invite_id IS NOT NULL) OR (mode = 'RANKED' AND invite_id IS NULL)` [name: 'chk_battles_invite_matches_mode']
    `mode = 'RANKED' OR (challenger_rating_before IS NULL AND challenger_rating_delta IS NULL AND opponent_rating_before IS NULL AND opponent_rating_delta IS NULL)` [name: 'chk_battles_friendly_no_rating']
    `mode = 'FRIENDLY' OR result IS NULL OR (challenger_rating_before IS NOT NULL AND challenger_rating_delta IS NOT NULL AND opponent_rating_before IS NOT NULL AND opponent_rating_delta IS NOT NULL)` [name: 'chk_battles_ranked_rating_complete']
  }

  Note: 'FRIENDLY: nasce da un invito; un invito produce al massimo una partita. RANKED: nasce dal matchmaking, senza invito; lo sfidante è chi è entrato in coda per primo. result resta nullo finché la simulazione non è completata e salvata. Per le RANKED le colonne di rating si scrivono nella stessa transazione di result. Il salvataggio blocca la riga e si ferma se result è già valorizzato: due retry sovrapposti non assegnano due volte Elo e crediti.'
}


////////////////////////////////////////////////////////////
// CLASSIFICATE: MATCHMAKING E RATING
////////////////////////////////////////////////////////////

Table matchmaking_queue {
  user_id int [pk, ref: - users.id]
  deck_id int [not null]  // ON DELETE CASCADE, vedi Ref sotto

  rating int [not null]   // rating al momento dell'ingresso in coda

  queued_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    deck_id
    rating
    queued_at
  }

  Note: 'Un ticket per utente (chiave primaria). La riga si elimina quando l utente esce dalla coda, viene abbinato o il suo account viene disattivato. Abbinamento: prima il ticket più vecchio, avversario entro +/-100 di rating; la finestra si allarga di 50 ogni 10 secondi di attesa, fino a +/-400. Le righe si leggono con FOR UPDATE SKIP LOCKED, così due esecuzioni non abbinano lo stesso utente. Anti-boosting: si salta un avversario già affrontato in una RANKED negli ultimi 10 minuti. Eliminare i due ticket e creare la partita avviene in una sola transazione, dopo aver rivalidato entrambi i mazzi. Eliminare il mazzo elimina il ticket (cascade); modificarlo lo rimuove dal codice.'
}

Ref: matchmaking_queue.deck_id > decks.id [delete: cascade]

Table player_ratings {
  user_id int [pk, ref: - users.id]

  rating int [not null, default: 1000]
  peak_rating int [not null, default: 1000]

  games_played int [not null, default: 0]
  wins int [not null, default: 0]
  losses int [not null, default: 0]
  draws int [not null, default: 0]

  Indexes {
    rating      // creato dalla baseline per la classifica, che non si fa (Q-10): non serve, si può togliere con una migrazione nuova decisa insieme
  }

  Checks {
    `rating >= 0` [name: 'chk_player_ratings_rating_nonnegative']
    `peak_rating >= rating` [name: 'chk_player_ratings_peak']
    `wins >= 0 AND losses >= 0 AND draws >= 0` [name: 'chk_player_ratings_counters_nonnegative']
    `games_played = wins + losses + draws` [name: 'chk_player_ratings_games_total']
  }

  Note: 'Solo statistiche RANKED: le FRIENDLY non toccano questa tabella. La riga si crea al primo ingresso in coda. Elo (approvato dal cliente): parte da 1000; atteso = 1 / (1 + 10^((R_avversario - R) / 400)); punteggio = 1 vittoria, 0,5 pareggio, 0 sconfitta; variazione = round(K * (punteggio - atteso)); K = 40 nelle prime 10 classificate, poi 20. Il rating non scende sotto 0. Prima di aggiornare si bloccano le due righe con SELECT ... FOR UPDATE, user_id minore per primo, per evitare deadlock.'
}


////////////////////////////////////////////////////////////
// AMICIZIE
////////////////////////////////////////////////////////////

Table friendships {
  requester_id int [not null, ref: > users.id]
  recipient_id int [not null, ref: > users.id]

  status FriendshipStatus [not null, default: 'PENDING']

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (requester_id, recipient_id) [pk]
    (`LEAST(requester_id, recipient_id)`, `GREATEST(requester_id, recipient_id)`) [unique, name: 'uq_friendships_pair']
    (recipient_id, status)
  }

  Checks {
    `requester_id != recipient_id` [name: 'chk_friendships_no_self_friendship']
  }

  Note: 'Al massimo una riga per coppia di utenti, in qualunque direzione. Accettare aggiorna lo stato; rifiutare, ritirare o rimuovere elimina la riga. La richiesta inversa a una già PENDING la accetta (gestita dal codice).'
}


////////////////////////////////////////////////////////////
// SCAMBI
////////////////////////////////////////////////////////////

Table trades {
  id uuid [pk]

  requester_id int [not null, ref: > users.id]
  recipient_id int [not null, ref: > users.id]

  status TradeStatus [not null, default: 'WAITING_RECIPIENT']

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`] // ultima offerta, controproposta o risposta

  Indexes {
    requester_id
    (recipient_id, status)
  }

  Checks {
    `requester_id != recipient_id` [name: 'chk_trades_no_self_trade']
  }

  Note: 'Partecipanti e passaggi di stato sono controllati dal codice. Lo stato dice di chi è il turno. Gli scambi non scadono: restano aperti finché uno dei due non li chiude.'
}

Table trade_offers {
  trade_id uuid [not null, ref: > trades.id]
  user_id int [not null, ref: > users.id]
  card_id int [not null, ref: > catalog_cards.id]

  quantity int [not null]

  Indexes {
    (trade_id, user_id, card_id) [pk]
    (user_id, card_id)
  }

  Checks {
    `quantity > 0` [name: 'chk_trade_offers_quantity_positive']
  }

  Note: 'user_id è il partecipante che cede la carta. Una controproposta sostituisce le righe esistenti. Le copie di chi ha fatto l offerta in corso sono riservate finché lo scambio è aperto: disponibili = possedute - riservate. Le carte si spostano in una sola transazione.'
}


////////////////////////////////////////////////////////////
// INVENTARIO E CREDITI
////////////////////////////////////////////////////////////

Table inventories {
  user_id int [pk, ref: - users.id]

  credits int [not null, default: 0]

  Checks {
    `credits >= 0` [name: 'chk_inventories_credits_nonnegative']
  }

  Note: 'Un inventario per utente. È anche il blocco di ogni spostamento di crediti, carte e pacchetti: si blocca la riga di ogni utente coinvolto, in ordine di user_id crescente.'
}

Table credit_transactions {
  id int [pk, increment]

  user_id int [not null, ref: > users.id]

  amount int [not null]            // positivo se guadagnati, negativo se spesi, 0 per un pacchetto gratuito
  reason CreditReason [not null]

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (user_id, created_at)
  }

  Note: 'Storico dei movimenti di crediti. Una riga per ogni modifica del saldo, nella stessa transazione. Le righe non si modificano e non si cancellano.'
}


////////////////////////////////////////////////////////////
// PACCHETTI
////////////////////////////////////////////////////////////

Table packs {
  id int [pk, increment]

  name varchar(255) [not null, unique]

  cost int [not null]

  // Massimo di pacchetti che un utente può comprare in totale. Nullo = nessun limite.
  purchase_limit int

  image_path text [not null]

  // Nasce disattivato: si attiva (POST /admin/packs/{id}/activate) solo quando i suoi slot base possono essere riempiti.
  is_active boolean [not null, default: false]

  Indexes {
    is_active
  }

  Checks {
    `cost >= 0` [name: 'chk_packs_cost_nonnegative']
    `purchase_limit IS NULL OR purchase_limit >= 1` [name: 'chk_packs_purchase_limit']
    `cost > 0 OR purchase_limit IS NOT NULL` [name: 'chk_packs_free_requires_limit']
  }

  Note: 'Il numero di carte è la somma delle quantità in pack_rarity_rules. I bonus sostituiscono slot base, non aggiungono carte.'
}

Table pack_inventory {
  user_id int [not null, ref: > inventories.user_id]
  pack_id int [not null, ref: > packs.id]

  // Sempre > 0: quando arriva a 0 la riga si elimina.
  quantity int [not null]

  Indexes {
    (user_id, pack_id) [pk]
    pack_id
  }

  Checks {
    `quantity > 0` [name: 'chk_pack_inventory_quantity_positive']
  }
}

Table pack_openings {
  id int [pk, increment]

  user_id int [not null, ref: > users.id]
  pack_id int [not null, ref: > packs.id]

  cards jsonb [not null]   // carte ricevute, nell'ordine degli slot

  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (user_id, created_at)
    created_at
  }

  Note: 'Storico delle aperture: una riga per ogni pacchetto aperto, nella stessa transazione. Serve alle statistiche del backoffice e a verificare le probabilità reali. Le righe non si modificano e non si cancellano.'
}

////////////////////////////////////////////////////////////
// SLOT BASE PER RARITÀ
////////////////////////////////////////////////////////////

Table pack_rarity_rules {
  pack_id int [not null, ref: > packs.id]
  rarity_id int [not null, ref: > rarities.id]

  // Numero di slot base di questa rarità.
  quantity int [not null]

  Indexes {
    (pack_id, rarity_id) [pk]
    rarity_id
  }

  Checks {
    `quantity > 0` [name: 'chk_pack_rarity_rules_quantity_positive']
  }

  Note: 'Esempio: 3 Common, 2 Uncommon, 2 Rare. I bonus cambiano le carte che riempiono gli slot, non il loro numero.'
}


////////////////////////////////////////////////////////////
// PROBABILITÀ DEI BONUS PER RARITÀ
////////////////////////////////////////////////////////////

Table pack_bonus_rules {
  pack_id int [not null, ref: > packs.id]
  rarity_id int [not null, ref: > rarities.id]

  // Da 0 a 10.000 unità, cioè dallo 0% al 100%.
  // Esempio: 1.000 = 10%; 100 = 1%; 10 = 0,1%.
  probability_units int [not null]

  Indexes {
    (pack_id, rarity_id) [pk]
    rarity_id
  }

  Checks {
    `probability_units >= 0 AND probability_units <= 10000` [name: 'chk_pack_bonus_rules_probability_range']
  }

  Note: 'Ogni rarità si tira in modo indipendente. Ogni bonus riuscito, dal più raro, sostituisce uno slot base partendo dalla rarità più alta. Un bonus di una rarità senza carte valide non scatta.'
}


////////////////////////////////////////////////////////////
// FILTRI DEI PACCHETTI
////////////////////////////////////////////////////////////

Table pack_tags {
  pack_id int [not null, ref: > packs.id]
  tag_id int [not null, ref: > tags.id]

  Indexes {
    (pack_id, tag_id) [pk]
    tag_id
  }

  Note: 'Una carta è idonea se ha almeno uno dei tag del pacchetto, nei tag propri o in quelli di una delle sue fazioni. Una variante è idonea solo tramite i tag propri. Un pacchetto senza righe qui accetta qualsiasi carta attiva, tranne le varianti.'
}


////////////////////////////////////////////////////////////
// AUDIT
////////////////////////////////////////////////////////////

Table audit_logs {
  id int [pk, increment]
  admin_user_id int [not null]
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id varchar(100) [not null]
  old_values jsonb
  new_values jsonb
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (admin_user_id, created_at)
    (entity_type, entity_id)
    created_at
  }

  Note: 'Azioni e modifiche fatte dal backoffice. Le righe non si modificano e non si cancellano, e non contengono mai password_hash o token.'
}

Ref: users.id < audit_logs.admin_user_id


////////////////////////////////////////////////////////////
// NOTIFICHE
////////////////////////////////////////////////////////////

Table notifications {
  id int [pk, increment]                 // usato come id dell'evento SSE (Last-Event-ID)
  user_id int [not null, ref: > users.id]
  type varchar(50) [not null]            // es. FRIEND_REQUEST_RECEIVED, BATTLE_COMPLETED: testo e non enum, così un nuovo tipo non richiede una migrazione
  payload jsonb [not null]               // id e username delle entità coinvolte, mai altri dati personali
  read_at timestamptz                    // nullo = non letta
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (user_id, read_at)
    (user_id, id)
  }

  Note: 'Notifiche degli utenti (amicizie, inviti, partite, scambi). Si salvano sempre e si inviano anche sul canale SSE, dopo il commit della transazione che le crea.'
}
